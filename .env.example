# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Variable names match what Azure App Service / Azure Functions inject
# automatically when a PostgreSQL service connector is attached -- see
# data-pipeline/wealthguard_pipeline/config.py.

# --- PostgreSQL (local docker-compose, or Azure Database for PostgreSQL) ---
AZURE_POSTGRESQL_HOST=localhost
AZURE_POSTGRESQL_PORT=5432
AZURE_POSTGRESQL_DATABASE=wealthguard
AZURE_POSTGRESQL_USER=wealthguard
AZURE_POSTGRESQL_PASSWORD=wealthguard
# Azure enforces TLS; the local docker-compose container does not.
AZURE_POSTGRESQL_SSL=false

# --- Java quality engine ---
WG_QUALITY_API_URL=http://localhost:8080
WG_QUALITY_API_TIMEOUT=30
WG_QUALITY_BATCH_SIZE=500
WG_QUALITY_API_RETRIES=3

# --- Grafana (ops monitoring dashboard, docker-compose only) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Azure Blob Storage (optional; absent = pipeline reads/writes local files) ---
# AZURE_STORAGE_CONNECTION_STRING=

# --- Assistant en langage naturel (LangChain, cahier des charges §2.4) ---
# Optionnel : le reste du projet (pipeline, moteur Java, frontend, Grafana,
# CI/CD) fonctionne sans ces variables. A ne renseigner que pour utiliser
# `wg-ask` ou `uvicorn wealthguard_pipeline.assistant.api:app`.
#
# Fournisseur par defaut : Groq (palier gratuit reel, pas un essai --
# https://console.groq.com/keys pour la cle). LangChain est concu pour etre
# agnostique du fournisseur : passer WG_ASSISTANT_PROVIDER=anthropic pour
# utiliser Claude a la place ne change pas une ligne du code assistant.
WG_ASSISTANT_PROVIDER=groq
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
WG_ASSISTANT_MAX_ROWS=200
WG_ASSISTANT_STATEMENT_TIMEOUT_MS=5000
# WG_ASSISTANT_MODEL=              # sinon, defaut par fournisseur (voir config.py)
